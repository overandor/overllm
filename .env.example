# OverLLM environment template
# Copy to .env locally or configure these in your deployment secret store.
# Do not commit real secrets.

# Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OVERLLM_LIB_PATH=./lib/liboverllm.dylib

# Public API safety
# Public deployments must keep command execution disabled unless a no-shell allowlist runner exists.
OVERLLM_ENABLE_TERMINAL=0

# Comma-separated explicit origins. Do not use wildcard CORS in public deployments.
OVERLLM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File endpoint boundary. Scope this to a non-sensitive directory for demos.
OVERLLM_FILE_ROOT=.

# Production runtime controls for api.prod_app:app
# Use a deployment secret store for OVERLLM_API_KEY; never commit a real value.
OVERLLM_API_KEY=
OVERLLM_REQUIRE_API_KEY=0
OVERLLM_RATE_LIMIT_ENABLED=1
OVERLLM_RATE_LIMIT_PER_MINUTE=60

# Financeable evidence ledger
# For diligence/customer use, set a long random secret through a secret manager.
# Leave blank only for local unsigned demo records.
OVERLLM_LEDGER_SECRET=
OVERLLM_FINANCE_ROOT=.overllm/finance

# Deployment posture metadata
OVERLLM_DEPLOYMENT_CLASS=local-demo
OVERLLM_RELEASE_SHA=
OVERLLM_OPERATOR_CONTACT=

# Safety assertions expected for public deployments
OVERLLM_LIVE_TRADING_ENABLED=0
OVERLLM_AUTONOMOUS_OUTBOUND_ENABLED=0
OVERLLM_APPROVAL_GATE_REQUIRED=1
