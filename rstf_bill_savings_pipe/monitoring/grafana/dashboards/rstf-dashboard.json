{
  "dashboard": {
    "title": "RSTF Performance Dashboard",
    "panels": [
      {
        "title": "Token Reduction Rate",
        "targets": [
          {
            "expr": "rate(rstf_tokens_saved_total[5m]) / rate(rstf_tokens_total[5m]) * 100"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Total Tokens Processed",
        "targets": [
          {
            "expr": "sum(rstf_tokens_total)"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Total Tokens Saved",
        "targets": [
          {
            "expr": "sum(rstf_tokens_saved_total)"
          }
        ],
        "type": "stat"
      },
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(rstf_requests_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Error Rate",
        "targets": [
          {
            "expr": "rate(rstf_errors_total[5m]) / rate(rstf_requests_total[5m]) * 100"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rstf_latency_seconds_bucket[5m]))"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
